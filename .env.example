# Universal API Key (otomatis mendeteksi Gemini, OpenAI, Groq, Claude, OpenRouter)
# Atau masukkan langsung melalui tombol "API Key" di Web UI (Zero-Retention, aman untuk pengujian).
LLM_API_KEY=your_ai_api_key_here
# Opsional: GEMINI_API_KEY= / OPENAI_API_KEY= / GROQ_API_KEY= / ANTHROPIC_API_KEY= / OPENROUTER_API_KEY= / DEEPSEEK_API_KEY=

DJANGO_SECRET_KEY=change-this-secret-key-in-production
DJANGO_DEBUG=true

DB_ENGINE=postgres
POSTGRES_DB=chatbot_faq_ti
POSTGRES_USER=faq_user
POSTGRES_PASSWORD=faq_pass
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
